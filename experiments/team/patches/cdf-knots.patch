+/* knotbench.c — CDF-knot map A/B in ONE binary (cdf-knots, 2026-09-12).
+ *
+ * The engine is built once with -DLOGOS_CDF_KNOTS. The map is switched off per call through the
+ * environment (LOGOS_KNOTS=0, read once per partition in cd_build), so the two halves of every pair
+ * run the SAME machine code and the paired ratio carries no code-layout bias (CLAUDE.md rule 3; the
+ * hf_lpt_on / LOGOS_LPT pattern). bench_paired returns t(off)/t(on): above 1.000 means the map is
+ * faster. Every output is verified against qsort before timing.
+ *
+ * Usage: ./knotbench [pairs] [n] [shape] [threads]     LOGOS_THREADS=N overrides the parallel count. */
+#define _GNU_SOURCE
+#include "bench_common.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+#include <stdint.h>
+
+void kn0_sort_f64(double *, size_t, int); int kn0_num_cpus(void);
+
+static void knots_off(double *a, size_t n, int P) { setenv("LOGOS_KNOTS", "0", 1); kn0_sort_f64(a, n, P); }
+static void knots_on(double *a, size_t n, int P)  { setenv("LOGOS_KNOTS", "1", 1); kn0_sort_f64(a, n, P); }
+
+static uint64_t RS = 88172645463325252ULL;
+static uint64_t nr(void) { RS ^= RS << 13; RS ^= RS >> 7; RS ^= RS << 17; return RS; }
+static double fr(void) { return (double)(nr() >> 11) / (double)(1ULL << 53); }
+
+typedef void (*gen_fn)(double *, size_t);
+static void g_heavy(double *a, size_t n)     { for (size_t i = 0; i < n; i++) a[i] = 1000.0 * pow(1.0 - fr() * 0.999999, -1.0 / 1.2); }   /* parbench's heavy_tail */
+static void g_pareto25(double *a, size_t n)  { for (size_t i = 0; i < n; i++) a[i] = 1000.0 * pow(1.0 - fr() * 0.999999, -1.0 / 2.5); }
+static void g_lognorm(double *a, size_t n)   { for (size_t i = 0; i < n; i++) { double u = fr() + 1e-12, v = fr(); a[i] = exp(3.0 * sqrt(-2.0 * log(u)) * cos(6.283185307 * v)); } }
+static void g_expon(double *a, size_t n)     { for (size_t i = 0; i < n; i++) a[i] = -1e6 * log(1.0 - fr() * 0.999999); }
+static void g_uniform(double *a, size_t n)   { for (size_t i = 0; i < n; i++) a[i] = fr() * 2e9 - 1e9; }
+static void g_bimodal(double *a, size_t n)   { for (size_t i = 0; i < n; i++) a[i] = ((nr() & 1) ? 1e9 : -1e9) + fr() * 1e6; }
+static void g_quant(double *a, size_t n)     { for (size_t i = 0; i < n; i++) a[i] = (double)(nr() % 4096) / 64.0; }
+static void g_clustered(double *a, size_t n) { for (size_t i = 0; i < n; i++) a[i] = (double)(nr() % 16) * 1e8 + fr() * 1e5; }
+static void g_intwide(double *a, size_t n)   { for (size_t i = 0; i < n; i++) a[i] = (double)(int32_t)(uint32_t)nr(); }
+static void g_gauss(double *a, size_t n)     { for (size_t i = 0; i < n; i++) { double u = fr() + 1e-12, v = fr(); a[i] = 1e6 * sqrt(-2.0 * log(u)) * cos(6.283185307 * v); } }
+
+static const struct { const char *name; gen_fn g; } SH[] = {
