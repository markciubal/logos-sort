+    size_t i;
+    switch (d) {
+    case 0: for (i = 0; i < n; i++) a[i] = 1000.0 * pow(1.0 - fr() * 0.999999, -1.0 / 1.2); break;
+    case 1: for (i = 0; i < n; i++) a[i] = 1000.0 * pow(1.0 - fr() * 0.999999, -1.0 / 2.5); break;
+    case 2: for (i = 0; i < n; i++) { double u = fr() + 1e-12, v = fr(); a[i] = exp(3.0 * sqrt(-2.0 * log(u)) * cos(6.283185307 * v)); } break;
+    case 3: for (i = 0; i < n; i++) a[i] = fr() * 2e9 - 1e9; break;
+    case 4: for (i = 0; i < n; i++) a[i] = ((nr() & 1) ? 1e9 : -1e9) + fr() * 1e6; break;
+    case 5: for (i = 0; i < n; i++) a[i] = (double)(nr() % 4096) / 64.0; break;
+    case 6: for (i = 0; i < n; i++) a[i] = -1e6 * log(1.0 - fr() * 0.999999); break;
+    case 7: for (i = 0; i < n; i++) a[i] = (double)(nr() % 16) * 1e8 + fr() * 1e5; break;
+    default: for (i = 0; i < n; i++) a[i] = (double)(int32_t)(uint32_t)nr(); break;
+    }
+}
