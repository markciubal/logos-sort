+    /* CDF-knot map edges (-DLOGOS_CDF_KNOTS, mode 10): a heavy tail on both sides of zero (a knot
+     * segment crossing the sign boundary of the key space, span near 2^64); a lognormal (bent both
+     * ways); a tail with three dominant duplicates (runs in the sample, knots on steps); and a tail with
+     * far sentinels (the bulk falls into one or two index cells, so the multi-knot loop runs). */
+    case D_PARETONEG: for (i = 0; i < n; i++) { double p = 1000.0 * pow(1.0 - frand() * 0.999999, -1.0 / 1.2); a[i] = (nextr() & 1) ? p : -p; } break;
+    case D_LOGNORM:   for (i = 0; i < n; i++) { double u = frand() + 1e-12, v = frand(); a[i] = exp(3.0 * sqrt(-2.0 * log(u)) * cos(6.283185307 * v)); } break;
