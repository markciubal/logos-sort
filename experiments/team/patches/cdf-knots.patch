+    const char *only = argc > 1 && argv[1][0] && strcmp(argv[1], "all") ? argv[1] : NULL;
+    int P = argc > 2 ? atoi(argv[2]) : bench_threads(logos_num_cpus());
+    size_t n = argc > 3 ? (size_t)atol(argv[3]) : 8000000;
+    double *a = malloc(n * 8);
+    for (int d = 0; d < NS; d++) {
+        if (only && strcmp(only, NM[d])) continue;
+        RS = 7; gen(a, n, d);
+        fprintf(stderr, "== %s, %d threads, n=%zu\n", NM[d], P, n);
+        logos_sort_f64(a, n, P);
+        for (size_t i = 1; i < n; i++) if (a[i - 1] > a[i]) { fprintf(stderr, "UNSORTED\n"); return 1; }
+    }
+    return 0;
+}
