+    case D_TAILSENT:  for (i = 0; i < n; i++) { uint64_t r = nextr() % 1000; a[i] = r == 0 ? 1e300 : r == 1 ? -1e300 : 1000.0 * pow(1.0 - frand() * 0.999999, -1.0 / 1.2); } break;
