+        for (int th = 0; th < p->nthreads && th < LOGOS_PROF_MAX_THREADS; th++) {
+            double b = 0, c = 0; for (int ph = 0; ph < LOGOS_PH_N; ph++) { b += p->busy_ms[th][ph]; c += p->cpu_ms[th][ph]; }
