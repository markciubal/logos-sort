+/* pagerbench.c — D1 step 2 A/B: relocation by memcpy (shipped) vs by page table (LOGOS_PAGE_RELOC).
+ *
+ * ONE engine, built with -DLOGOS_PAGE_RELOC, whose page path is a runtime toggle (the environment
+ * variable LOGOS_PAGE_RELOC, read per call): both variants share every byte of code, so the
+ * code-layout bias of two compiled copies (methodology rule 3) does not exist here, and
+ * bench_paired's adjacent pairs cancel the machine's drift. Ratio > 1 means the page path is faster.
+ *
+ * Every row first runs the page path once and checks the output is sorted and a permutation of the
+ * input (xor of raw bits), and reports whether the path FIRED (bytes moved by page table): a row
+ * that never fired is a null by construction and must read 1.00.
+ * Rows: the bench shapes (64 blocks at 8M: cannot fire, fixed points only), then block sizes that
+ * are 2 MB multiples on a malloc'd array (base 16 bytes into a page, so a 4 MB run holds one whole
+ * 2 MB unit, a 16 MB run seven) and the same on a 2 MB-aligned array the caller aligned itself.
+ * Usage: ./pagerbench [pairs] [rows]     LOGOS_THREADS=N overrides the parallel thread count. */
+#define _GNU_SOURCE
+#include "bench_common.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+
+extern size_t logos_page_reloc_bytes, logos_page_reloc_calls;
+
+static uint64_t RS = 88172645463325252ULL;
+static uint64_t nr(void) { RS ^= RS << 13; RS ^= RS >> 7; RS ^= RS << 17; return RS; }
+static double fr(void) { return (double)(nr() >> 11) / (double)(1ULL << 53); }
+static uint64_t xsum(const double *a, size_t n) { uint64_t x = 0; for (size_t i = 0; i < n; i++) { uint64_t u; memcpy(&u, &a[i], 8); x ^= u; } return x; }
+
+static void gen_blocks(double *a, size_t n, size_t nb, int overlap_every) {
+    size_t blk = (n + nb - 1) / nb; size_t *perm = malloc(nb * sizeof(size_t));
+    for (size_t k = 0; k < nb; k++) perm[k] = k;
+    for (size_t k = nb - 1; k > 0; k--) { size_t j = nr() % (k + 1); size_t t = perm[k]; perm[k] = perm[j]; perm[j] = t; }
+    for (size_t i = 0; i < n; i++) { size_t b = perm[i / blk]; double base = (double)b * (double)blk;
+        if (overlap_every && (b % overlap_every) == 1) base -= (double)blk * 0.1;
+        a[i] = base + (double)(i % blk) + fr() * 0.5; }
+    free(perm);
+}
+static void sort_base(double *a, size_t n, int t) { unsetenv("LOGOS_PAGE_RELOC"); logos_sort_f64(a, n, t); }
+static size_t g_page_calls, g_page_fired, g_page_syscalls;   /* every page-path call inside bench_paired: did it fire, and how many syscalls */
+static void sort_page(double *a, size_t n, int t) { setenv("LOGOS_PAGE_RELOC", "1", 1); logos_sort_f64(a, n, t); g_page_calls++; if (logos_page_reloc_bytes) { g_page_fired++; g_page_syscalls += logos_page_reloc_calls; } }
+
+int main(int argc, char **argv) {
+    int reps = argc > 1 ? atoi(argv[1]) : 20; if (reps < 6) reps = 6;
+    int P = bench_threads(logos_num_cpus());
+    struct { const char *name; size_t n, nb; int ov, aligned; } S[] = {
+        { "block_perm 8M/64 (bench)",       8000000, 64, 0, 0 },
+        { "block_overlap 8M/64 (bench)",    8000000, 64, 8, 0 },
+        { "block_perm 2^23/64 (1 MB)",     1u << 23, 64, 0, 0 },
+        { "block_perm 2^23/16 (4 MB)",     1u << 23, 16, 0, 0 },
+        { "block_perm 2^25/64 (4 MB)",     1u << 25, 64, 0, 0 },
+        { "block_perm 2^25/16 (16 MB)",    1u << 25, 16, 0, 0 },
+        { "block_perm 2^23/16 (4 MB) 2MB-aligned array",  1u << 23, 16, 0, 1 },
+        { "block_perm 2^25/64 (4 MB) 2MB-aligned array",  1u << 25, 64, 0, 1 },
+        { "block_perm 2^25/16 (16 MB) 2MB-aligned array", 1u << 25, 16, 0, 1 },
+    };
+    int NS = (int)(sizeof S / sizeof S[0]);
+    int only = argc > 2 ? atoi(argv[2]) : 0;   /* bitmask of rows, 0 = all */
+    printf("pagerbench: memcpy relocation vs page-table relocation, one binary, runtime toggle; %d pairs, threads %d and 1\n", reps, P);
+    printf("ratio = t(memcpy) / t(page table), median of pairs [p10, p90]; > 1 favours the page path\n");
+    printf("  %-48s %-3s %10s %11s %6s   %s\n", "shape", "thr", "moved", "mremaps", "ratio", "[p10, p90]");
+    for (int s = 0; s < NS; s++) {
+        if (only && !(only & (1 << s))) continue;
+        size_t n = S[s].n; double *base = malloc(n * 8), *work;
+        if (S[s].aligned) { if (posix_memalign((void **)&work, 2u << 20, n * 8)) return 1; } else work = malloc(n * 8);
+        if (!base || !work) return 1;
+        RS = 88172645463325252ULL + (uint64_t)s * 7919; gen_blocks(base, n, S[s].nb, S[s].ov); uint64_t before = xsum(base, n);
+        for (int ti = 0; ti < 2; ti++) {
+            int t = ti ? 1 : P;
+            /* verify both variants, and see whether the page path fired at this thread count */
+            memcpy(work, base, n * 8); sort_page(work, n, t); size_t moved = logos_page_reloc_bytes, calls = logos_page_reloc_calls;
+            if (xsum(work, n) != before) { printf("NOT A PERMUTATION (page path, %s, %d thr)\n", S[s].name, t); return 1; }
+            for (size_t i = 1; i < n; i++) if (work[i - 1] > work[i]) { printf("UNSORTED (page path, %s, %d thr, i=%zu)\n", S[s].name, t, i); return 1; }
+            memcpy(work, base, n * 8); sort_base(work, n, t);
+            if (xsum(work, n) != before) { printf("NOT A PERMUTATION (memcpy path, %s, %d thr)\n", S[s].name, t); return 1; }
+            for (size_t i = 1; i < n; i++) if (work[i - 1] > work[i]) { printf("UNSORTED (memcpy path, %s, %d thr)\n", S[s].name, t); return 1; }
+            g_page_calls = g_page_fired = g_page_syscalls = 0;
+            double p10, p90, med = bench_paired(sort_base, sort_page, base, work, n, t, reps, &p10, &p90);
+            printf("  %-48s %-3d %9.1f%% %11zu %6.3f   [%.3f, %.3f]   fired %zu/%zu calls, %.0f mremaps/call%s\n", S[s].name, t, 100.0 * (double)moved / ((double)n * 8), calls, med, p10, p90,
+                   g_page_fired, g_page_calls, g_page_fired ? (double)g_page_syscalls / (double)g_page_fired : 0.0, moved ? "" : "   (did not fire: null row)");
+            fflush(stdout);
+        }
+        free(base); free(work);
+    }
+    printf("all outputs verified sorted and permutation-exact\n");
+    return 0;
+}
