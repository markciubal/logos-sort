+/* mmprobe.c — D1 mechanism probe: what does moving a run by page table cost on THIS box?
+ *
+ * Two 64 MB anonymous regions A and B. For run sizes 64 KB .. 16 MB, and with 0 or 13 helper
+ * threads spinning on other CPUs (so every mremap must shoot down their TLBs, as it would with the
+ * engine's workers alive), time per run:
+ *   memcpy1   : one memcpy A->B                     (one direction, one thread)
+ *   memcpy2   : A->B then B->A                       (what the route does: out to scratch, back)
+ *   pmemcpy2  : the same two copies over P threads   (what the parallel route does)
+ *   mremap2   : mremap A[run]->B[run] then back      (page path: two syscalls per run, no bytes)
+ * hugepage=1 rows madvise(MADV_HUGEPAGE) both regions and align runs to 2 MB, so a run whose
+ * length is a 2 MB multiple moves by PMD. Every mremap'd page is checked afterwards to hold the
+ * value it was filled with (the region is refilled with its page index).
+ * Usage: ./mmprobe [threads]   times are the minimum of 5 reps, printed as microseconds per run. */
+#define _GNU_SOURCE
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <sys/mman.h>
+#include <time.h>
+#include <unistd.h>
+
+static double now(void) { struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t); return t.tv_sec * 1e6 + t.tv_nsec / 1e3; }
+static atomic_int g_stop, g_go;
+static void *spinner(void *p) { (void)p; while (!atomic_load(&g_stop)) { for (volatile int i = 0; i < 1000; i++); } return NULL; }
+
+typedef struct { char *src, *dst; size_t lo, hi; } cp_t;
+static void *copier(void *p) { cp_t *c = p; memcpy(c->dst + c->lo, c->src + c->lo, c->hi - c->lo); return NULL; }
+static void pcopy(char *dst, char *src, size_t bytes, int P) {
+    pthread_t th[64]; cp_t c[64];
+    for (int t = 0; t < P; t++) { c[t].src = src; c[t].dst = dst; c[t].lo = bytes * t / P; c[t].hi = bytes * (t + 1) / P; pthread_create(&th[t], NULL, copier, &c[t]); }
+    for (int t = 0; t < P; t++) pthread_join(th[t], NULL);
+}
+static void fill(char *r, size_t bytes) { for (size_t i = 0; i < bytes; i += 4096) memset(r + i, (int)((i / 4096) & 0xFF), 4096); }
+static int check(const char *r, size_t bytes) { for (size_t i = 0; i < bytes; i += 4096) if ((unsigned char)r[i] != ((i / 4096) & 0xFF) || (unsigned char)r[i + 4095] != ((i / 4096) & 0xFF)) return 0; return 1; }
+
+int main(int argc, char **argv) {
+    int P = argc > 1 ? atoi(argv[1]) : 14; if (P > 64) P = 64;
+    const size_t TOTAL = 64u << 20;
+    printf("mmprobe: mremap vs memcpy per run, 64 MB regions, P=%d for the parallel copy, min of 5 reps, microseconds per run\n", P);
+    printf("%-8s %-6s %-9s %9s %9s %9s %9s   %s\n", "hugepage", "spin", "run", "memcpy1", "memcpy2", "pmemcpy2", "mremap2", "mremap2/pmemcpy2");
+    for (int huge = 0; huge < 2; huge++) {
+        size_t align = huge ? (2u << 20) : 4096;
+        char *rawA = mmap(NULL, TOTAL + align, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+        char *rawB = mmap(NULL, TOTAL + align, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+        if (rawA == MAP_FAILED || rawB == MAP_FAILED) return 1;
