+/* pagebench.c — D1 step 1: what do the relocation route's runs look like in page terms?
+ *
+ * Links an engine built with -DLOGOS_TRACE, whose relocation route prints a census of its run
+ * descriptors: run-length histogram, and the bytes that could move by page-table edit (mremap)
+ * at 4 KB and 2 MB granularity. Not a timing benchmark; there is nothing to time yet.
+ *
+ * Shapes: the bench generator's block_perm / block_overlap (64 blocks) at 8M and 30M, then block
+ * sizes chosen so 8*blk IS a page multiple (the only case the arithmetic allows), at power-of-two n.
+ * Usage: ./pagebench [threads]                                        LOGOS_THREADS=N overrides. */
+#define _GNU_SOURCE
+#include "bench_common.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+
+void pt_sort_f64(double *, size_t, int); int pt_num_cpus(void);
+
+static uint64_t RS = 88172645463325252ULL;
+static uint64_t nr(void) { RS ^= RS << 13; RS ^= RS >> 7; RS ^= RS << 17; return RS; }
+static double fr(void) { return (double)(nr() >> 11) / (double)(1ULL << 53); }
+
+/* same construction as parbench.cpp / j5bench.c: nb sorted blocks with disjoint value ranges,
+   shuffled; overlap_every > 0 makes every such value-block start 10% inside its predecessor */
+static void gen_blocks(double *a, size_t n, size_t nb, int overlap_every) {
+    size_t blk = (n + nb - 1) / nb; size_t *perm = malloc(nb * sizeof(size_t));
+    for (size_t k = 0; k < nb; k++) perm[k] = k;
+    for (size_t k = nb - 1; k > 0; k--) { size_t j = nr() % (k + 1); size_t t = perm[k]; perm[k] = perm[j]; perm[j] = t; }
+    for (size_t i = 0; i < n; i++) { size_t b = perm[i / blk]; double base = (double)b * (double)blk;
+        if (overlap_every && (b % overlap_every) == 1) base -= (double)blk * 0.1;
+        a[i] = base + (double)(i % blk) + fr() * 0.5; }
+    free(perm);
+}
+
+int main(int argc, char **argv) {
+    int P = argc > 1 ? atoi(argv[1]) : bench_threads(pt_num_cpus());
+    struct { const char *name; size_t n, nb; int ov; } S[] = {
+        { "block_perm 8M/64 (bench)",        8000000, 64, 0 }, { "block_overlap 8M/64 (bench)",   8000000, 64, 8 },
+        { "block_perm 30M/64 (bench)",      30000000, 64, 0 }, { "block_overlap 30M/64 (bench)", 30000000, 64, 8 },
+        { "block_perm 8M/blk4096 (32 KB)",   8000000, 8000000 / 4096 + 1, 0 },
+        { "block_perm 8M/blk65536 (512 KB)", 8000000, 8000000 / 65536 + 1, 0 },
+        { "block_perm 2^23/64 (1 MB)",     1u << 23, 64, 0 }, { "block_overlap 2^23/64 (1 MB)", 1u << 23, 64, 8 },
+        { "block_perm 2^23/16 (4 MB)",     1u << 23, 16, 0 },
+        { "block_perm 2^25/64 (4 MB)",     1u << 25, 64, 0 }, { "block_overlap 2^25/64 (4 MB)", 1u << 25, 64, 8 },
+        { "block_perm 2^25/16 (16 MB)",    1u << 25, 16, 0 },
+    };
+    int NS = (int)(sizeof S / sizeof S[0]);
+    for (int s = 0; s < NS; s++) {
+        size_t n = S[s].n; double *a = malloc(n * sizeof(double)); if (!a) return 1;
+        for (int seed = 0; seed < 2; seed++) {
+            RS = 88172645463325252ULL + (uint64_t)seed * 7919; gen_blocks(a, n, S[s].nb, S[s].ov);
+            fprintf(stderr, "== %s seed %d, %d threads\n", S[s].name, seed, P);
+            pt_sort_f64(a, n, P);
+            for (size_t i = 1; i < n; i++) if (a[i - 1] > a[i]) { fprintf(stderr, "UNSORTED\n"); return 1; }
+        }
+        free(a);
+    }
+    fprintf(stderr, "all outputs verified sorted\n");
+    return 0;
+}
