+/* ---- D1 prototype: relocation by page table (experiments/team/pagetable-reloc.md) ------------
+ * OPT-IN twice over: compile with -DLOGOS_PAGE_RELOC, then set LOGOS_PAGE_RELOC=1 in the environment
+ * (read per call, so one binary A/Bs both variants with no code-layout bias; make pagerbench).
+ * A run whose source and destination byte offsets agree modulo 2 MB has its 2 MB-aligned interior
+ * moved by mremap(MREMAP_FIXED) into a scratch mapping placed at a[]'s 2 MB phase: one PMD entry
+ * per 2 MB, no bytes copied. The ragged ends and every other run are memcpy'd as before. The
+ * scratch then goes back into a[] the same way, piece by piece in dst order (a moved span and the
+ * memcpy'd gap after it are each one VMA, and mremap needs one), the sub-unit head and tail by
+ * memcpy. Fires only when every chain is a single run and at least PR_MIN_FRACTION_PCT of the
+ * bytes would move. mmprobe measured the PMD move at 16-30x cheaper per run than the parallel
+ * two-way copy, and the PTE-level (4 KB-aligned) move at no gain below 16 MB runs, so nothing
+ * below a 2 MB unit is tried. Costs a caller must accept: a[]'s middle ends up as up to 2R+1
+ * anonymous private VMAs (freed normally by free/munmap), the frames that end up in a[] are the
+ * scratch's, and the memcpy'd fraction of the scratch is faulted fresh on every call
+ * (MADV_HUGEPAGE keeps that to one fault per 2 MB). Linux only. */
+#ifdef LOGOS_PAGE_RELOC
+#define PR_UNIT ((uintptr_t)2 << 20)
+#ifndef PR_MIN_FRACTION_PCT
+#define PR_MIN_FRACTION_PCT 25
+#endif
+size_t logos_page_reloc_bytes = 0, logos_page_reloc_calls = 0;   /* last logos_sort_f64: bytes moved by page table, mremap calls (0: did not fire) */
+typedef struct { void *map; size_t map_len; double *dst; size_t *mlo, *mhi; size_t moved, calls; } pr_t;
+static int page_reloc_on(void) { return getenv("LOGOS_PAGE_RELOC") != NULL; }
+static int pr_move(void *from, void *to, size_t len) { return mremap(from, len, len, MREMAP_MAYMOVE | MREMAP_FIXED, to) != MAP_FAILED; }
+/* A range whose pages just moved away is a HOLE, and any mmap in the process (a thread stack, a malloc
+   arena) may land in it; the first cut crashed exactly so: 100% of a[] moved out, the workers' stacks
+   were placed in the hole, phase 3 mapped data over the cached stacks, the next pthread_create died.
+   So every vacated range is re-reserved at once, PROT_NONE and page-free (an accidental touch faults
+   loudly), and the later MREMAP_FIXED into it replaces the reservation. */
+static int pr_reserve(void *at, size_t len) { return mmap(at, len, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED | MAP_NORESERVE, -1, 0) != MAP_FAILED; }
+/* mremap needs its old range inside ONE VMA, and after a page-mode sort a[] is a set of VMAs laid out
+   in that sort's destination order, so a later call whose run straddles two of them fails (seen: an
+   8 MB fused run over two 4 MB pieces, EFAULT, every later call declined). Try the span whole, then
+   one 2 MB unit at a time; a unit never straddles a piece since pieces are unit-multiples. Returns
+   the number of units moved (all, or 0 with the moved ones put back), and counts the syscalls. */
+static size_t pr_move_span(void *from, void *to, size_t len, size_t *calls) {
+    if (pr_move(from, to, len)) { (*calls)++; return len / PR_UNIT; }
+    size_t u, nu = len / PR_UNIT;
+    for (u = 0; u < nu; u++) { if (!pr_move((char *)from + u * PR_UNIT, (char *)to + u * PR_UNIT, PR_UNIT)) break; (*calls)++; }
+    if (u == nu) return nu;
+    for (size_t r = 0; r < u; r++) { pr_move((char *)to + r * PR_UNIT, (char *)from + r * PR_UNIT, PR_UNIT); (*calls)++; }
+    return 0;
+}
+static void pr_free(pr_t *pr) { if (pr->map) munmap(pr->map, pr->map_len); free(pr->mlo); free(pr->mhi); pr->map = NULL; pr->mlo = pr->mhi = NULL; }
+/* phase 1: plan the movable units and move them out of a[] into the scratch. 1 = page mode (pr->dst is
+   the scratch, a[] has holes where the units were), 0 = declined with nothing touched. */
+static int page_reloc_out(double *a, size_t n, const rdesc_t *d, const size_t *off, size_t R, pr_t *pr) {
+    memset(pr, 0, sizeof *pr);
+    uintptr_t A = (uintptr_t)a; size_t movable = 0;
+    pr->mlo = malloc(R * sizeof(size_t)); pr->mhi = malloc(R * sizeof(size_t));
+    if (!pr->mlo || !pr->mhi) { pr_free(pr); return 0; }
+    for (size_t q = 0; q < R; q++) {
+        uintptr_t s = A + d[q].start * sizeof(double), e = s + d[q].len * sizeof(double);
+        pr->mlo[q] = pr->mhi[q] = off[q] + d[q].len;                                     /* empty window: nothing of this run moves */
+        if (((d[q].start - off[q]) * sizeof(double)) & (PR_UNIT - 1)) continue;         /* phase differs mod 2 MB: no unit can move */
+        uintptr_t lo = (s + PR_UNIT - 1) & ~(PR_UNIT - 1), hi = e & ~(PR_UNIT - 1);     /* whole units strictly inside the run */
+        if (hi <= lo) continue;
+        pr->mlo[q] = off[q] + (lo - s) / sizeof(double); pr->mhi[q] = off[q] + (hi - s) / sizeof(double); movable += hi - lo;
+    }
+    if (movable < n * sizeof(double) / 100 * PR_MIN_FRACTION_PCT) { pr_free(pr); return 0; }
+    pr->map_len = n * sizeof(double) + 2 * PR_UNIT;
+    pr->map = mmap(NULL, pr->map_len, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
+    if (pr->map == MAP_FAILED) { pr->map = NULL; pr_free(pr); return 0; }
+#if defined(MADV_HUGEPAGE) && !defined(PR_NO_THP)
+    (void)madvise(pr->map, pr->map_len, MADV_HUGEPAGE);   /* one fault per 2 MB for the memcpy'd fraction; -DPR_NO_THP to compare */
+#endif
+    uintptr_t M = (uintptr_t)pr->map, D = M + ((A - M) & (PR_UNIT - 1));               /* D == A (mod 2 MB), D + n*8 <= M + map_len */
+    pr->dst = (double *)D;
+    for (size_t q = 0; q < R; q++) {
+        if (pr->mlo[q] == pr->mhi[q]) continue;
+        size_t len = (pr->mhi[q] - pr->mlo[q]) * sizeof(double);
+        void *from = a + d[q].start + (pr->mlo[q] - off[q]), *to = pr->dst + pr->mlo[q];
+        int moved_q = pr_move_span(from, to, len, &pr->calls) != 0;
+        if (!moved_q || !pr_reserve(from, len)) {                                          /* undo what moved, decline */
+            if (moved_q) { pr_move_span(to, from, len, &pr->calls); pr_reserve(to, len); }
+            for (size_t r = 0; r < q; r++) if (pr->mlo[r] != pr->mhi[r]) {
+                void *f2 = a + d[r].start + (pr->mlo[r] - off[r]), *t2 = pr->dst + pr->mlo[r]; size_t l2 = (pr->mhi[r] - pr->mlo[r]) * sizeof(double);
+                pr_move_span(t2, f2, l2, &pr->calls); pr_reserve(t2, l2);
+            }
+            pr_free(pr); return 0;
+        }
+        pr->moved += len;
+    }
+    return 1;
+}
+/* one piece of the scratch's unit-aligned middle back into a[]; a piece whose move fails is copied
+   instead, after giving a[] fresh pages there (its own may have moved out) */
+static void pr_piece(pr_t *pr, uintptr_t A, uintptr_t D, uintptr_t lo, uintptr_t hi) {
+    if (hi <= lo) return;
+    size_t len = hi - lo; void *to = (void *)(A + (lo - D));
+    if (pr_move_span((void *)lo, to, len, &pr->calls)) { pr_reserve((void *)lo, len); return; }
+    if (mmap(to, len, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0) == MAP_FAILED) abort();   /* cannot leave a[] holed */
+    memcpy(to, (void *)lo, len);
+}
+/* phase 3: the scratch's whole 2 MB units go back into a[] by page table, in dst order; head and tail
+   below unit size by memcpy. Every byte of dst[0, n) was written in phase 1, so nothing here is a
+   never-touched page. */
+static void page_reloc_back(double *a, size_t n, size_t R, pr_t *pr) {
+    uintptr_t A = (uintptr_t)a, D = (uintptr_t)pr->dst, N = n * sizeof(double);
+    uintptr_t U0 = (A + PR_UNIT - 1) & ~(PR_UNIT - 1), U1 = (A + N) & ~(PR_UNIT - 1);
+    if (U1 <= U0) { memcpy(a, pr->dst, N); return; }                                       /* cannot happen once phase 1 fired; kept as the safe form */
+    memcpy(a, pr->dst, U0 - A); memcpy((char *)a + (U1 - A), (char *)pr->dst + (U1 - A), A + N - U1);
+    uintptr_t cur = D + (U0 - A), end = D + (U1 - A);
+    for (size_t q = 0; q < R; q++) {
+        if (pr->mlo[q] == pr->mhi[q]) continue;
+        uintptr_t sl = D + pr->mlo[q] * sizeof(double), sh = D + pr->mhi[q] * sizeof(double);
+        pr_piece(pr, A, D, cur, sl); pr_piece(pr, A, D, sl, sh); cur = sh;
+    }
+    pr_piece(pr, A, D, cur, end);
+}
+#define PR_WINDOWS(pm, pr) (pm) ? (pr).mlo : NULL, (pm) ? (pr).mhi : NULL
+#else
+#define PR_WINDOWS(pm, pr) NULL, NULL
+#endif
+
