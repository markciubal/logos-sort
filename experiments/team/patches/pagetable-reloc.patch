+        if (huge) { madvise(A, TOTAL, MADV_HUGEPAGE); madvise(B, TOTAL, MADV_HUGEPAGE); }
+        fill(A, TOTAL); fill(B, TOTAL);
+        for (int spin = 0; spin < 2; spin++) {
+            pthread_t sp[64]; int ns = spin ? P - 1 : 0; atomic_store(&g_stop, 0);
+            for (int t = 0; t < ns; t++) pthread_create(&sp[t], NULL, spinner, NULL);
+            usleep(20000);
+            size_t runs[] = { 64u << 10, 256u << 10, 1u << 20, 4u << 20, 16u << 20 };
