+                size_t L = runs[ri], nruns = TOTAL / L; double b1 = 1e300, b2 = 1e300, bp = 1e300, bm = 1e300;
+                for (int rep = 0; rep < 5; rep++) {
+                    double s = now(); for (size_t q = 0; q < nruns; q++) memcpy(B + q * L, A + q * L, L); double t = (now() - s) / nruns; if (t < b1) b1 = t;
+                    s = now(); for (size_t q = 0; q < nruns; q++) { memcpy(B + q * L, A + q * L, L); memcpy(A + q * L, B + q * L, L); } t = (now() - s) / nruns; if (t < b2) b2 = t;
+                    s = now(); pcopy(B, A, TOTAL, P); pcopy(A, B, TOTAL, P); t = (now() - s) / nruns; if (t < bp) bp = t;
+                    s = now();
+                    for (size_t q = 0; q < nruns; q++) {
+                        /* move the run's pages to B's slot (B's pages there are discarded), then back */
+                        if (mremap(A + q * L, L, L, MREMAP_MAYMOVE | MREMAP_FIXED, B + q * L) == MAP_FAILED) { perror("mremap out"); return 1; }
+                        if (mremap(B + q * L, L, L, MREMAP_MAYMOVE | MREMAP_FIXED, A + q * L) == MAP_FAILED) { perror("mremap back"); return 1; }
+                    }
+                    t = (now() - s) / nruns; if (t < bm) bm = t;
+                    if (!check(A, TOTAL)) { printf("A corrupted after mremap round trip\n"); return 1; }
+                    /* B's slots are now holes: the round trip left B unmapped there; map and refill so the next rep's memcpy has a target */
+                    if (mmap(B, TOTAL, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0) == MAP_FAILED) return 1;
+                    if (huge) madvise(B, TOTAL, MADV_HUGEPAGE);
+                    fill(B, TOTAL);
+                }
+                printf("%-8d %-6d %-9zu %9.1f %9.1f %9.1f %9.1f   %6.2fx\n", huge, ns, L, b1, b2, bp, bm, bm / bp);
+            }
+            atomic_store(&g_stop, 1); for (int t = 0; t < ns; t++) pthread_join(sp[t], NULL);
+        }
+        munmap(rawA, TOTAL + align); munmap(rawB, TOTAL + align);
+    }
+    printf("mremap2/pmemcpy2 < 1 means the page path beats the parallel two-way copy at that run size\n");
+    return 0;
+}
