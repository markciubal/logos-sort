+/* k interleaved sorted runs: element i belongs to run i mod k, and each run is sorted. transp: the
+ * runs' value ranges are disjoint in class order (a sorted matrix with k rows read column-major). */
+static void gen_ileave(double *a, size_t n, size_t k, int transp) {
+    if (n == 0) return;
+    double *t = malloc(n * sizeof(double)); size_t i, r;
+    for (i = 0; i < n; i++) t[i] = frand() * 2e9 - 1e9;
+    if (transp) qsort(t, n, sizeof(double), cmp_d);
+    size_t o = 0;
+    for (r = 0; r < k; r++) {
+        size_t len = n / k + (r < n % k ? 1 : 0), q;
+        if (!transp) qsort(t + o, len, sizeof(double), cmp_d);
+        for (q = 0; q < len; q++) a[q * k + r] = t[o + q];
+        o += len;
+    }
+    free(t);
+}
