+static int cmp_dd(const void *a, const void *b) { double x = *(const double *)a, y = *(const double *)b; return (x > y) - (x < y); }
+/* team/strided-probe: k interleaved sorted runs (element i in run i mod k); transp = runs value-disjoint
+ * in class order (a sorted k-row matrix read column-major). Plus two guards that exercise the probe
+ * at 1T without taking the route: near_sorted (s = 1 must die) and 64 contiguous runs. */
+static void g_ileave(double *a, size_t n, size_t k, int transp) {
+    double *t = malloc(n * sizeof(double)); size_t i, r, o = 0;
+    for (i = 0; i < n; i++) t[i] = fr() * 2e9 - 1e9;
+    if (transp) qsort(t, n, sizeof(double), cmp_dd);
+    for (r = 0; r < k; r++) { size_t len = n / k + (r < n % k ? 1 : 0), q; if (!transp) qsort(t + o, len, sizeof(double), cmp_dd); for (q = 0; q < len; q++) a[q * k + r] = t[o + q]; o += len; }
+    free(t);
+}
+static void g_il2(double *a, size_t n)  { g_ileave(a, n, 2, 0); }
+static void g_il7(double *a, size_t n)  { g_ileave(a, n, 7, 0); }
+static void g_il8(double *a, size_t n)  { g_ileave(a, n, 8, 0); }
+static void g_il64(double *a, size_t n) { g_ileave(a, n, 64, 0); }
+static void g_tr64(double *a, size_t n) { g_ileave(a, n, 64, 1); }
+static void g_nearsort(double *a, size_t n) { for (size_t i = 0; i < n; i++) a[i] = (double)i + fr() * 0.5; for (size_t i = 0; i < n / 100; i++) { size_t x = nr() % n, y = nr() % n; double t = a[x]; a[x] = a[y]; a[y] = t; } }
+static void g_segmented(double *a, size_t n) { size_t blk = n / 64 ? n / 64 : 1; for (size_t i = 0; i < n; i++) a[i] = (double)(i % blk) * 64.0 + (double)(i / blk) + fr() * 0.5; }
+
