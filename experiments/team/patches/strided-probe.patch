+/* ---- strided order: k interleaved sorted runs (experiments/team/strided-probe.md) ------------------
+ * A sorted matrix read column-major, a round-robin interleave of k sorted streams, a merge of k shards
+ * taken one element each in turn: a[i] is non-decreasing along every residue class i mod k. No probe
+ * above can see it (runs of length ~1, inversion rate ~50%, no block structure, full cardinality), so
+ * it goes to the partition and pays a histogram-free scatter plus a full leaf sort for data that is
+ * already k sorted sequences.
+ *
+ * PROBE. STRIDED_M windows of STRIDED_MAX_K+1 elements at p_j = j*step + floor(frac(j*phi)*step):
+ * ascending in j by construction, jittered by the Weyl sequence so the residues p_j mod s are
+ * equidistributed for every s (a plain stride j*step would put every sample into one class for any s
+ * dividing step and pass vacuously -- ORDER_FROM_CHAOS M5 in reverse). Every s in 1..STRIDED_MAX_K is
+ * tested in one pass with two conditions, because each alone has a measured false positive:
+ *   window  a[p] <= a[p+s]: the lag-s NEIGHBOUR must not descend. For a wrong s the neighbour is in a
+ *           different run at nearly the same quantile, a coin flip, so s dies within a few samples.
+ *           Needed because k interleaved runs of one distribution are COARSELY sorted (a[i] is about
+ *           the i/n quantile with noise of order sqrt(n)), so any test on samples thousands of
+ *           positions apart passes for every s: the class test alone returned k = 5 on an 8-interleave.
+ *   class   the samples ascend inside each residue class mod s: rejects data that is locally ascending
+ *           at lag s but not globally (a sawtooth whose period is far above s passes the window test
+ *           for s = 2 with 68% probability at 1024 samples; the class test kills it at the first period).
+ * s = 1 surviving means nearly sorted, which is the near-sorted route's, so the probe declines. The
+ * smallest survivor is k: a k-interleave is also ascending along every multiple of k, never along a
+ * proper divisor unless the runs happen to interleave in value. A compact alive list means random
+ * data kills every s within the first few dozen samples (~150 compares in the trace).
+ *
+ * ROUTE, filter-then-verify: the probe only has to be cheap, never a proof, because the gather copies
+ * the k runs contiguously into scratch while checking a[i] >= a[i-k] for EVERY element (NaN fails that
+ * compare too) and any violation bails with a[] untouched. After one barrier:
+ *   - runs value-disjoint in class order (the transposed matrix; the probe's windows predict this from
+ *     the row order a[p+i] <= a[p+i+1], the gathered runs confirm it): scratch IS the sorted array,
+ *     parallel copy back. Two passes, zero compares, any k up to STRIDED_MAX_K.
+ *   - otherwise, for k <= STRIDED_MERGE_MAX_K, log2(k) passes of a BRANCH-FREE 2-way merge, ping-pong
+ *     between scratch and a[]. Each thread owns the output slice between two splitters from the
+ *     dispatcher's sorted sample; lower-bounding the splitters in every run once gives, by prefix
+ *     sums, its segment of every merged group at every level; a barrier separates the levels because
+ *     each level's writes overlap, in the other buffer, what slower threads still read. When the pass
+ *     count is even the last pass lands in scratch and one copy pass follows.
+ * A k-way loser tree was built first and measured (trace, 1T, loaded box): 24 ns/elem for k = 2 but
+ * 230 for k = 8 and 410 for k = 64 against a 115 ns/elem partition in the same run, i.e. 2-4x SLOWER
+ * than the partition for k >= 8, the ledger's "a merge is comparison work" in a new coat: log2(k)
+ * dependent, mispredicted steps per element. It is kept opt-in (-DLOGOS_STRIDED_LOSER_TREE). The
+ * branch-free 2-way merge runs at ~2.4 ns/elem per pass, so the merge route is capped at
+ * STRIDED_MERGE_MAX_K = 8 (three passes) and k above that declines up front unless the windows say the
+ * runs are disjoint. MERGE_MAX_RUNS (8) is a cap on the LEAF's galloping 4-way ladder and does not
+ * apply here. -DLOGOS_NO_STRIDED restores the pristine dispatcher (the A/B baseline). */
+#ifndef LOGOS_NO_STRIDED
+#ifndef STRIDED_MAX_K
+#define STRIDED_MAX_K 64
+#endif
+#ifndef STRIDED_MERGE_MAX_K
+#define STRIDED_MERGE_MAX_K 8
+#endif
+#ifndef STRIDED_M
+#define STRIDED_M 1024
+#endif
+#define STRIDED_MIN_N 4096
+#ifdef LOGOS_TRACE
+static size_t g_strided_probe_ops;   /* compares the probe made (the mechanism, for the trace) */
+#endif
+/* Smallest k in 2..STRIDED_MAX_K that survives both tests at every sample, or 0. *rowasc = 1 when every
+ * sampled row of the k-column view is ascending too, i.e. the runs look value-disjoint in class order. */
+static int strided_probe_f64(const double *a, size_t n, int *rowasc) {
+    *rowasc = 0;
+    if (n < STRIDED_MIN_N) return 0;
+    const size_t m = STRIDED_M, W = STRIDED_MAX_K, span = n - W - 1, step = span / m;   /* n >= 4096: step >= 3 */
+    uint32_t pos[STRIDED_M];
+    for (size_t j = 0; j < m; j++) {
+        double f = (double)j * 0.6180339887498949; f -= (double)(uint64_t)f;
+        size_t q = j * step + (size_t)(f * (double)step); if (q > span) q = span;
+        pos[j] = (uint32_t)q;
+        for (size_t o = 0; o <= W; o += 8) __builtin_prefetch(a + q + o, 0, 0);
+    }
+    /* last[off[s] + r]: the last sample seen in class r of stride s (-inf = none yet) */
+    double last[(STRIDED_MAX_K * (STRIDED_MAX_K + 1)) / 2 + 1];
+    int off[STRIDED_MAX_K + 1], alive[STRIDED_MAX_K], na = 0;
+    for (int s = 1, o = 0; s <= STRIDED_MAX_K; s++) { off[s] = o; o += s; alive[na++] = s; }
+    for (size_t i = 0; i < sizeof last / sizeof last[0]; i++) last[i] = -INFINITY;
+    size_t ops = 0;
+    for (size_t j = 0; j < m && na > 0; j++) {
+        uint32_t p = pos[j]; double v = a[p];
+        int w = 0;
+        for (int q = 0; q < na; q++) {
+            int s = alive[q]; ops++;
+            if (!(a[p + s] >= v)) continue;                                      /* window (NaN fails) */
+            double *L = last + off[s] + (int)(p % (uint32_t)s);
+            if (!(v >= *L)) continue;                                            /* class */
+            *L = v; alive[w++] = s;
+        }
+        na = w;
+    }
+#ifdef LOGOS_TRACE
+    g_strided_probe_ops = ops;
+#else
+    (void)ops;
+#endif
+    if (na == 0) return 0;
+    int k = alive[0];                                                            /* alive[] stays ascending */
+    if (k < 2) return 0;
+    int ra = 1;                                                                  /* rows ascending -> runs disjoint in class order */
+    for (size_t j = 0; j < m && ra; j++) {
+        uint32_t p = pos[j];
+        for (int i = 0; i < k; i++) if ((p + (uint32_t)i) % (uint32_t)k != (uint32_t)(k - 1) && !(a[p + i] <= a[p + i + 1])) { ra = 0; break; }
+    }
+    *rowasc = ra;
+    return k;
+}
+
+typedef struct {
+    double *a, *dst; size_t n, k, Q; int P, t;
+    const size_t *base;                    /* base[r]: start of run r in dst; base[k] = n */
+    const double *samp; size_t m;          /* sorted sample for the P-way split (NULL: self-sample) */
+    atomic_int *abort; barrier_t *bar;
+    int disjoint;                          /* set by thread 0 after phase 1 */
+} strided_arg_t;
+
+static inline size_t strided_lower_bound(const double *r, size_t len, double v) {
+    size_t lo = 0, hi = len;
+    while (lo < hi) { size_t mid = (lo + hi) >> 1; if (r[mid] < v) lo = mid + 1; else hi = mid; }
+    return lo;
+}
+/* Branch-free 2-way merge: one compare, one select, two pointer bumps per element; ties take p. */
+static void strided_merge2(const double *p, size_t na, const double *q, size_t nb, double *o) {
+    const double *pe = p + na, *qe = q + nb;
+    while (p < pe && q < qe) { double x = *p, y = *q; int c = y < x; *o++ = c ? y : x; q += c; p += c ^ 1; }
+    memcpy(o, p, (size_t)(pe - p) * sizeof(double)); o += pe - p;
+    memcpy(o, q, (size_t)(qe - q) * sizeof(double));
+}
+#ifdef LOGOS_STRIDED_LOSER_TREE
+/* MEASURED NEGATIVE, kept opt-in (see the header comment): k-way loser tree, one pass, log2(k)
+ * dependent compares per element. An exhausted or dummy leaf carries +inf, and if such a leaf ever
+ * wins then every live key is +inf too, so the rest of the output is +inf and the loop stops (real
+ * +inf values are handled without a tie-break that way). */
+static void strided_merge_k(const double *const *src, const size_t *len, int k, double *out, size_t total) {
+    if (k == 2) { strided_merge2(src[0], len[0], src[1], len[1], out); return; }
+    int K = 1; while (K < k) K <<= 1;
+    const double *pos[2 * STRIDED_MAX_K], *end[2 * STRIDED_MAX_K]; double key[2 * STRIDED_MAX_K]; int tree[2 * STRIDED_MAX_K];
+    for (int i = 0; i < K; i++) {
+        if (i < k) { pos[i] = src[i]; end[i] = src[i] + len[i]; key[i] = len[i] ? src[i][0] : INFINITY; }
+        else { pos[i] = end[i] = NULL; key[i] = INFINITY; }
+        tree[i] = -1;
+    }
+    for (int i = 0; i < K; i++) {                                                /* play the tournament */
+        int cur = i, node = (i + K) >> 1;
+        for (; node > 0; node >>= 1) {
+            int l = tree[node];
+            if (l < 0) { tree[node] = cur; cur = -1; break; }
+            if (key[l] < key[cur]) { tree[node] = cur; cur = l; }
+        }
+        if (cur >= 0) tree[0] = cur;
+    }
+    for (size_t o = 0; o < total; o++) {
+        int w = tree[0];
+        if (pos[w] == end[w]) { for (; o < total; o++) out[o] = INFINITY; break; }
+        out[o] = key[w]; pos[w]++;
+        key[w] = pos[w] < end[w] ? *pos[w] : INFINITY;
+        int cur = w;
+        for (int node = (w + K) >> 1; node > 0; node >>= 1) {
+            int l = tree[node]; int lt = key[l] < key[cur];
+            tree[node] = lt ? cur : l; cur = lt ? l : cur;
+        }
+        tree[0] = cur;
+    }
+}
+#endif
+static void *strided_worker(void *p) {
+    strided_arg_t *w = p; const size_t n = w->n, k = w->k, Q = w->Q; const int P = w->P, t = w->t;
+    double *a = w->a, *dst = w->dst; const size_t *base = w->base;
+    /* phase 1: gather rows [qlo, qhi) of the k-column view into the k runs, verifying each column */
+    size_t qlo = (size_t)t * Q / (size_t)P, qhi = (size_t)(t + 1) * Q / (size_t)P;
+    for (size_t q = qlo; q < qhi; q++) {
+        size_t b = q * k, lim = n - b < k ? n - b : k;
+        if (b == 0) { for (size_t r = 0; r < lim; r++) { double v = a[r]; if (v != v) goto fail; dst[base[r]] = v; } continue; }
+        const double *row = a + b, *prev = row - k;
+        for (size_t r = 0; r < lim; r++) { double v = row[r]; if (!(v >= prev[r])) goto fail; dst[base[r] + q] = v; }
+        if ((q & 1023) == 0 && atomic_load(w->abort)) break;                  /* another thread found a violation */
+    }
+    if (0) { fail: atomic_store(w->abort, 1); }
+    if (P > 1) barrier_wait(w->bar);                                             /* every thread reaches it, bailed or not */
+    if (t == 0) TRACE("strided: gather %s", atomic_load(w->abort) ? "bailed" : "done");
+    if (atomic_load(w->abort)) return NULL;
+    /* phase 2a: runs disjoint in class order -> dst is sorted, copy back (decided identically on every thread) */
+    { int dis = 1; for (size_t r = 0; r + 1 < k && dis; r++) if (!(dst[base[r + 1] - 1] <= dst[base[r + 1]])) dis = 0;
+      if (t == 0) w->disjoint = dis;
+      if (dis) { size_t lo = (size_t)t * n / (size_t)P, hi = (size_t)(t + 1) * n / (size_t)P; memcpy(a + lo, dst + lo, (hi - lo) * sizeof(double)); return NULL; }
+      if (k > STRIDED_MERGE_MAX_K) { atomic_store(w->abort, 1); return NULL; } }   /* the windows guessed disjoint and were wrong: a[] is untouched, decline */
+    /* phase 2b: this thread's slice, cut by two splitters, through log2(k) branch-free 2-way passes */
+    size_t c0[STRIDED_MAX_K + 1], c1[STRIDED_MAX_K + 1];                         /* prefix sums of the level-0 cuts */
+    double vlo = 0, vhi = 0;
+    if (P > 1) {
+        double own[STRIDED_M]; const double *S = w->samp; size_t m = w->m;
+        if (!S) {                                                                /* deterministic, so every thread agrees */
+            m = STRIDED_M; for (size_t j = 0; j < m; j++) own[j] = dst[weyl_pos(j, n)];
+            sample_sort(own, m); S = own;
+        }
+        vlo = t > 0 ? S[(size_t)t * m / (size_t)P] : 0; vhi = t + 1 < P ? S[(size_t)(t + 1) * m / (size_t)P] : 0;
+    }
+    c0[0] = c1[0] = 0;
+    for (size_t r = 0; r < k; r++) {
+        const double *run = dst + base[r]; size_t L = base[r + 1] - base[r];
+        c0[r + 1] = c0[r] + (t == 0 ? 0 : strided_lower_bound(run, L, vlo));
+        c1[r + 1] = c1[r] + (t == P - 1 ? L : strided_lower_bound(run, L, vhi));
+    }
+    size_t olo = c0[k], total = c1[k] - c0[k];
+#ifdef LOGOS_STRIDED_LOSER_TREE
+    { const double *src[STRIDED_MAX_K]; size_t len[STRIDED_MAX_K];
+      for (size_t r = 0; r < k; r++) { src[r] = dst + base[r] + (c0[r + 1] - c0[r]); len[r] = (c1[r + 1] - c1[r]) - (c0[r + 1] - c0[r]); }
+      strided_merge_k(src, len, (int)k, a + olo, total); return NULL; }
+#else
+    double *S = dst, *D = a;
+    for (size_t st = 1; st < k; st <<= 1) {                                      /* level: groups of st runs, merged in pairs */
+        for (size_t g0 = 0; g0 < k; g0 += 2 * st) {
+            size_t g0e = g0 + st < k ? g0 + st : k, g1 = g0e, g1e = g1 + st < k ? g1 + st : k;
+            const double *A0 = S + base[g0] + (c0[g0e] - c0[g0]); size_t la = (c1[g0e] - c1[g0]) - (c0[g0e] - c0[g0]);
+            double *O = D + base[g0] + (c0[g1e] - c0[g0]);
+            if (g1 >= k) { memcpy(O, A0, la * sizeof(double)); continue; }        /* odd group out: passes through */
+            const double *A1 = S + base[g1] + (c0[g1e] - c0[g1]); size_t lb = (c1[g1e] - c1[g1]) - (c0[g1e] - c0[g1]);
+            strided_merge2(A0, la, A1, lb, O);
+        }
+        double *tmp = S; S = D; D = tmp;
+        /* The next level writes the other buffer in a coarser layout that overlaps what slower threads are
+         * still reading from it at this level (the harness caught it: ileave_7 at 2-8 threads), so the
+         * levels are separated by a barrier. log2(k) - 1 of them; none after the last level. */
+        if (P > 1 && (st << 1) < k) barrier_wait(w->bar);
+    }
+    if (S != a) {                                                                /* even pass count: the result sits in scratch */
+        if (P > 1) barrier_wait(w->bar);                                         /* the copy is a level too: slower threads still read a[] */
+        memcpy(a + olo, S + olo, total * sizeof(double));
+    }
+    return NULL;
+#endif
+}
+/* Returns 1 with a[] sorted, or 0 with a[] untouched (dst: n-element scratch; samp: the dispatcher's
+ * sorted sample of m values, or NULL). */
+static int strided_try_f64(double *a, size_t n, int P, double *dst, const double *samp, size_t m) {
+    int rowasc = 0, k = strided_probe_f64(a, n, &rowasc);
+#ifdef LOGOS_TRACE
+    TRACE("strided: probe k=%d rows_ascending=%d (%zu compares over %d windows)", k, rowasc, g_strided_probe_ops, STRIDED_M);
+#endif
+    if (k < 2) return 0;
+    if (!rowasc && k > STRIDED_MERGE_MAX_K) { TRACE("strided: k=%d above the merge cap and runs overlap: declined", k); return 0; }
+    if (n < MIN_PARALLEL) P = 1;
+    size_t Q = (n + (size_t)k - 1) / (size_t)k, base[STRIDED_MAX_K + 1];
+    for (size_t r = 0, o = 0; r <= (size_t)k; r++) { base[r] = o; o += n / (size_t)k + ((r < n % (size_t)k) ? 1 : 0); }
+    base[k] = n;
+    if ((size_t)P > Q) P = (int)Q;
+    barrier_t bar; atomic_int abort_flag; atomic_init(&abort_flag, 0);
+    strided_arg_t *wa = malloc((size_t)P * sizeof *wa); pthread_t *th = malloc((size_t)P * sizeof *th);
+    if (!wa || !th) { free(wa); free(th); return 0; }
+    if (P > 1) barrier_init(&bar, P);
+    for (int t = 0; t < P; t++) { strided_arg_t w = { a, dst, n, (size_t)k, Q, P, t, base, samp, m, &abort_flag, &bar, 0 }; wa[t] = w; }
+    for (int t = 1; t < P; t++) pthread_create(&th[t], NULL, strided_worker, &wa[t]);   /* same assumption as psort_f64 */
+    strided_worker(&wa[0]);
+    for (int t = 1; t < P; t++) pthread_join(th[t], NULL);
+    int ok = !atomic_load(&abort_flag);
+    TRACE("strided: %s (k=%d, P=%d)", !ok ? "bailed, a[] untouched" : wa[0].disjoint ? "gather verified, runs disjoint: copied back" : "gather verified, merged", k, P);
+    if (P > 1) barrier_destroy(&bar);
+    free(wa); free(th);
+    return ok;
+}
+#endif
