+/* stridetrace.c — does the strided route FIRE, and where does its time go? Built with -DLOGOS_TRACE.
+ * Not a benchmark: the trace timestamps are the mechanism, not a claim. Usage: ./stridetrace [n] [P] */
+#define _GNU_SOURCE
+#include "logos_psort.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+static uint64_t RS = 7; static uint64_t nr(void) { RS ^= RS << 13; RS ^= RS >> 7; RS ^= RS << 17; return RS; }
+static double fr(void) { return (double)(nr() >> 11) / (double)(1ULL << 53); }
+static int cmp_dd(const void *a, const void *b) { double x = *(const double *)a, y = *(const double *)b; return (x > y) - (x < y); }
+static void gen_ileave(double *a, size_t n, size_t k, int transp) {
+    double *t = malloc(n * sizeof(double)); size_t i, r, o = 0;
+    for (i = 0; i < n; i++) t[i] = fr() * 2e9 - 1e9;
+    if (transp) qsort(t, n, sizeof(double), cmp_dd);
+    for (r = 0; r < k; r++) { size_t len = n / k + (r < n % k ? 1 : 0), q; if (!transp) qsort(t + o, len, sizeof(double), cmp_dd); for (q = 0; q < len; q++) a[q * k + r] = t[o + q]; o += len; }
+    free(t);
+}
+int main(int argc, char **argv) {
+    size_t n = argc > 1 ? (size_t)atol(argv[1]) : 8000000; int P = argc > 2 ? atoi(argv[2]) : 14;
+    double *a = malloc(n * 8), *ref = malloc(n * 8);
+    const char *names[] = { "uniform", "near_sorted", "ileave_2", "ileave_8", "ileave_64", "transp_64", "ileave_break", "ileave_nan", "ileave_17" };
+    for (int s = 0; s < 9; s++) {
+        RS = 7;
+        switch (s) {
+        case 0: for (size_t i = 0; i < n; i++) a[i] = fr() * 2e9 - 1e9; break;
+        case 1: for (size_t i = 0; i < n; i++) a[i] = (double)i + fr() * 0.5; for (size_t i = 0; i < n / 100; i++) { size_t x = nr() % n, y = nr() % n; double t = a[x]; a[x] = a[y]; a[y] = t; } break;
+        case 2: gen_ileave(a, n, 2, 0); break;
+        case 3: gen_ileave(a, n, 8, 0); break;
+        case 4: gen_ileave(a, n, 64, 0); break;
+        case 5: gen_ileave(a, n, 64, 1); break;
+        case 6: gen_ileave(a, n, 8, 0); { size_t x = n * 9 / 10; double t = a[x]; a[x] = a[x + 8]; a[x + 8] = t; } break;
+        case 7: gen_ileave(a, n, 2, 0); a[n / 2] = NAN; break;
+        case 8: gen_ileave(a, n, 17, 0); break;
+        }
+        memcpy(ref, a, n * 8); { size_t kk = 0; for (size_t i = 0; i < n; i++) if (ref[i] == ref[i]) ref[kk++] = ref[i]; qsort(ref, kk, 8, cmp_dd); for (size_t i = kk; i < n; i++) ref[i] = NAN; }
