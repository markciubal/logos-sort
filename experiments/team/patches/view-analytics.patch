+static uint64_t RS = 88172645463325252ULL;
+static uint64_t nr(void) { RS ^= RS << 13; RS ^= RS >> 7; RS ^= RS << 17; return RS; }
+static double fr(void) { return (double)(nr() >> 11) / (double)(1ULL << 53); }
+static int cmp_i(const void *a, const void *b) { int32_t x = *(const int32_t *)a, y = *(const int32_t *)b; return (x > y) - (x < y); }
+static size_t lower_bound(const int32_t *r, size_t n, int32_t x) { size_t l = 0, h = n; while (l < h) { size_t m = (l + h) >> 1; if (r[m] < x) l = m + 1; else h = m; } return l; }
+
+typedef void (*gen_fn)(int32_t *, size_t);
+static void g_span1e8(int32_t *a, size_t n)   { for (size_t i = 0; i < n; i++) a[i] = (int32_t)(nr() % 100000000u); }
+static void g_full(int32_t *a, size_t n)      { for (size_t i = 0; i < n; i++) a[i] = (int32_t)nr(); }
+static void g_span2e5(int32_t *a, size_t n)   { for (size_t i = 0; i < n; i++) a[i] = (int32_t)(nr() % 200000u) - 100000; }
+static void g_clustered(int32_t *a, size_t n) { for (size_t i = 0; i < n; i++) a[i] = (int32_t)((nr() % 16) * 100000000u + (nr() % 100000u)); }
+static const struct { const char *name; gen_fn g; } SH[] = {
+    { "span_1e8", g_span1e8 }, { "full_range", g_full }, { "span_2e5", g_span2e5 }, { "clustered", g_clustered },
