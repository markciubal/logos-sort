+    case D_FEWDIST:  for (i = 0; i < n; i++) a[i] = (double)(nextr() % 5) * 1e6; break;
+    case D_EQUAL:    for (i = 0; i < n; i++) a[i] = 42.0; break;
+    case D_NEG:      for (i = 0; i < n; i++) a[i] = frand() * 2e6 - 1e6; break;
