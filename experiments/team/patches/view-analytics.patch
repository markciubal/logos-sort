+static size_t q_rank(double q, size_t n) { return (size_t)(q * (double)(n - 1) + 0.5); }
+static int32_t G_out[NQT];
+
+typedef void (*route_fn)(int32_t *, size_t, int);
+static void r_sort_index(int32_t *a, size_t n, int P) { logos_sort_i32(a, n, P); for (int i = 0; i < NQT; i++) G_out[i] = a[q_rank(QT[i], n)]; }
+static void r_view_quant(int32_t *a, size_t n, int P) { logos_view_i32 *v = logos_view_create_i32(a, n, P); logos_view_quantiles_i32(v, QT, NQT, G_out); logos_view_free_i32(v); }
