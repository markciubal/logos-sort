+/* bench_paired for int32 arrays: identical logic, 4-byte elements (see bench_common.h for the rationale) */
+static double paired_i32(route_fn A, route_fn B, const int32_t *base, int32_t *work, size_t n, int threads, int reps, double *p10, double *p90) {
+    double *r = malloc((size_t)reps * sizeof(double)); if (!r) return 0.0;
+    for (int i = 0; i < reps; i++) {
+        double ta, tb, s;
+        if (i & 1) {
+            memcpy(work, base, n * 4); s = bench_now_(); B(work, n, threads); tb = bench_now_() - s;
+            memcpy(work, base, n * 4); s = bench_now_(); A(work, n, threads); ta = bench_now_() - s;
+        } else {
+            memcpy(work, base, n * 4); s = bench_now_(); A(work, n, threads); ta = bench_now_() - s;
+            memcpy(work, base, n * 4); s = bench_now_(); B(work, n, threads); tb = bench_now_() - s;
+        }
+        r[i] = tb > 0 ? ta / tb : 1.0;
+    }
+    qsort(r, (size_t)reps, sizeof(double), bench_cmp_d_);
+    double med = (reps & 1) ? r[reps / 2] : 0.5 * (r[reps / 2 - 1] + r[reps / 2]);
+    if (p10) *p10 = r[(int)(0.10 * reps)];
+    if (p90) *p90 = r[(int)(0.90 * reps)];
+    free(r); return med;
